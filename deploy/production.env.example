# Copy to an owner-managed environment file and replace every digest. Do not
# commit the populated file. Compose refuses to start when any value is absent.
SCANNER_POSTGRES_IMAGE=postgres:16.4-alpine@sha256:REPLACE_WITH_APPROVED_DIGEST
SCANNER_SERVER_IMAGE=registry.example.invalid/scanner-platform-server@sha256:REPLACE_WITH_APPROVED_DIGEST
SCANNER_WORKER_IMAGE=registry.example.invalid/scanner-platform-worker@sha256:REPLACE_WITH_APPROVED_DIGEST
SCANNER_UPDATER_IMAGE=registry.example.invalid/scanner-platform-updater@sha256:REPLACE_WITH_APPROVED_DIGEST
